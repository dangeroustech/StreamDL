TICK_TIME=60
LOG_LEVEL=INFO
# Primary log destination: file (default), stdout, or both
LOG_DEST=file
# Optional override; default is /app/data/streamdl.log when LOG_DEST is file/both
# LOG_FILE=/app/data/streamdl.log

# User/group StreamDL runs as and owns its files with (default 1000:1000).
# e.g. TrueNAS SCALE's "apps" user is 568:568.
# PUID=1000
# PGID=1000
# Time zone used for recording filenames and log timestamps (default UTC)
# TZ=Europe/London
# Octal umask for created folders and moved recordings (default 022)
# UMASK=022

# Twitch live recordings skip ads through streamlink; 0 or false records them as v3 did
# TWITCH_ADFREE=true
# Twitch login token: the bare value of the auth-token cookie. With Turbo or a channel
# sub, Twitch sends no ads.
# TWITCH_OAUTH_TOKEN=

# Intel /dev/dri passthrough is configured in docker-compose (devices/group_add),
# not via env. See README "Intel Quick Sync / /dev/dri passthrough".
# The image's FFmpeg is static and has no QSV yet (#611).
