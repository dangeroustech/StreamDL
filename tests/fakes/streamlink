#!/usr/bin/env python3
"""Stand-in for streamlink in tests.

Each run appends a JSON record to $FAKE_STREAMLINK_LOG: its argv (without argv[0])
and, when --config is given, that file's text and permission bits and its
directory's. It then prints $FAKE_STREAMLINK_STDERR (newline-separated lines) to
stderr and writes b"fake ts data" to stdout.

The exit code comes from $FAKE_STREAMLINK_EXITS, a comma-separated list consumed
one entry per run (the last entry repeats). With FAKE_STREAMLINK_BLOCK=1 it
creates $FAKE_STREAMLINK_READY after writing and runs until a signal ends it;
FAKE_STREAMLINK_IGNORE_TERM=1 makes it ignore SIGTERM.
"""

import json
import os
import signal
import stat
import sys
import time

args = sys.argv[1:]
record = {"args": args, "config": None, "config_mode": None, "dir_mode": None}
if "--config" in args:
    path = args[args.index("--config") + 1]
    with open(path, encoding="utf-8") as f:
        record["config"] = f.read()
    record["config_mode"] = stat.S_IMODE(os.stat(path).st_mode)
    record["dir_mode"] = stat.S_IMODE(os.stat(os.path.dirname(path)).st_mode)

with open(os.environ["FAKE_STREAMLINK_LOG"], "a+", encoding="utf-8") as log:
    log.seek(0)
    run = sum(1 for _ in log)
    log.write(json.dumps(record) + "\n")

if os.environ.get("FAKE_STREAMLINK_IGNORE_TERM") == "1":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

for line in os.environ.get("FAKE_STREAMLINK_STDERR", "").split("\n"):
    if line:
        sys.stderr.write(line + "\n")
sys.stderr.flush()
sys.stdout.buffer.write(b"fake ts data")
sys.stdout.buffer.flush()

if os.environ.get("FAKE_STREAMLINK_BLOCK") == "1":
    with open(os.environ["FAKE_STREAMLINK_READY"], "w") as f:
        f.write("ready")
    while True:
        time.sleep(0.02)

exits = [int(x) for x in os.environ.get("FAKE_STREAMLINK_EXITS", "0").split(",")]
sys.exit(exits[min(run, len(exits) - 1)])
