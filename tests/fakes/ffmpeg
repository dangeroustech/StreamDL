#!/usr/bin/env python3
"""Stand-in for ffmpeg in tests.

Each run appends its argv (JSON, without argv[0]) to $FAKE_FFMPEG_LOG, prints a
couple of status lines to stderr and writes the output file (the last argument).
The exit code comes from $FAKE_FFMPEG_EXITS, a comma-separated list consumed one
entry per run (the last entry repeats). With FAKE_FFMPEG_BLOCK=1 it writes
"<output>.ready", runs until SIGINT, then writes "<output>.finalized" and exits
255 like ffmpeg does.

When the input is pipe:0 it then reads stdin to EOF and saves what it read to
"<output>.stdin" (FAKE_FFMPEG_SKIP_STDIN=1 skips the read). FAKE_FFMPEG_LINGER=1
makes it run, after that, until it is killed. With FAKE_FFMPEG_WAIT_FOR=<path>
it then waits for <path> to exist before going on. FAKE_FFMPEG_EMPTY_RUNS, a
comma-separated list of run numbers counted from 1, makes those runs write an
empty output file.

With "concat" in its arguments it acts as a join: it concatenates the files named
in the -i list (FFmpeg's concat syntax) into the output and exits
$FAKE_FFMPEG_CONCAT_EXIT (default 0). With FAKE_FFMPEG_CONCAT_BLOCK=1 it writes
"<output>.ready" and runs until killed.
"""

import json
import os
import signal
import sys
import time

args = sys.argv[1:]
with open(os.environ["FAKE_FFMPEG_LOG"], "a+", encoding="utf-8") as log:
    log.seek(0)
    run = sum(1 for _ in log)
    log.write(json.dumps(args) + "\n")

out = args[-1]
if "concat" in args:
    # A join: write the listed files' bytes, in order, to the output.
    data = b""
    with open(args[args.index("-i") + 1], encoding="utf-8") as listing:
        for line in listing:
            line = line.strip()
            if line.startswith("file '") and line.endswith("'"):
                with open(line[6:-1].replace("'\\''", "'"), "rb") as part:
                    data += part.read()
    with open(out, "wb") as f:
        f.write(data)
    if os.environ.get("FAKE_FFMPEG_CONCAT_BLOCK") == "1":
        with open(out + ".ready", "w") as f:
            f.write("ready")
        while True:
            time.sleep(0.02)
    sys.stderr.write("concat finished\n")
    sys.exit(int(os.environ.get("FAKE_FFMPEG_CONCAT_EXIT", "0")))
sys.stderr.write("Input #0, hls, from 'fake':\n")
sys.stderr.write(
    "frame=   10 fps=30 q=-1.0 size=     128kB time=00:00:01.00 bitrate=1048.6kbits/s speed=1.00x\r"
)
sys.stderr.write(
    "frame=   20 fps=30 q=-1.0 size=     256kB time=00:00:02.00 bitrate=1048.6kbits/s speed=1.00x\r"
)
sys.stderr.flush()
empty_runs = os.environ.get("FAKE_FFMPEG_EMPTY_RUNS", "").split(",")
with open(out, "wb") as f:
    if str(run + 1) not in empty_runs:
        f.write(b"fake mp4")

if "pipe:0" in args and os.environ.get("FAKE_FFMPEG_SKIP_STDIN") != "1":
    data = sys.stdin.buffer.read()
    with open(out + ".stdin", "wb") as f:
        f.write(data)

if os.environ.get("FAKE_FFMPEG_LINGER") == "1":
    while True:
        time.sleep(0.02)

if wait_for := os.environ.get("FAKE_FFMPEG_WAIT_FOR"):
    while not os.path.exists(wait_for):
        time.sleep(0.02)

if os.environ.get("FAKE_FFMPEG_BLOCK") == "1":
    interrupted = False

    def on_sigint(signum, frame):
        global interrupted
        interrupted = True

    signal.signal(signal.SIGINT, on_sigint)
    with open(out + ".ready", "w") as f:
        f.write("ready")
    while not interrupted:
        time.sleep(0.02)
    with open(out + ".finalized", "w") as f:
        f.write("ok")
    sys.exit(255)

exits = [int(x) for x in os.environ.get("FAKE_FFMPEG_EXITS", "0").split(",")]
sys.exit(exits[min(run, len(exits) - 1)])
