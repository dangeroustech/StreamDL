FROM mwader/static-ffmpeg:9.0.2 AS ffmpeg

# Go Binary Builder
FROM golang:1.27.3-alpine AS go-build
WORKDIR /app
COPY . .
RUN go get -v && \
    go build -o streamdl

# Golang Protobuf Client and Logic
# The binary is static (CGO disabled), so the runtime doesn't need the Go toolchain
FROM alpine:3.24.3 AS client

# su-exec and curl for running as non-root and health checks;
# tzdata so TZ works for recording filenames (Go no longer finds GOROOT's zoneinfo)
RUN apk add --no-cache su-exec curl tzdata ca-certificates

WORKDIR /app

# Copy FFMPEG Binaries
COPY --from=ffmpeg /ffmpeg /usr/local/bin/
COPY --from=ffmpeg /ffprobe /usr/local/bin/
COPY --from=go-build /app/streamdl .
COPY entrypoint_client.sh /app/entrypoint_client.sh
COPY streamdl_client_entrypoint.sh /app/streamdl_client_entrypoint.sh

# Make entrypoint scripts executable
RUN chmod +x /app/entrypoint_client.sh /app/streamdl_client_entrypoint.sh

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl --fail --max-time 5 --silent --output /dev/null http://localhost:8080/health || exit 1

# Entrypoint script handles user creation and switching
ENTRYPOINT ["/bin/sh", "/app/entrypoint_client.sh"]